# Copy to .env (never commit .env). Use 'node --env-file=.env src/server.js' to load.
APP_ORIGIN=http://localhost:3000
PORT=3000
SESSION_SECRET=replace-with-a-random-64-character-hex-string
BANK_DATA_KEY=replace-with-a-random-64-character-hex-string
# ENCRYPTION_KEY is an alias for BANK_DATA_KEY (32 bytes as 64 hex characters).
# Never generate a different key for an existing database. If both are set, they must match.
DB_PATH=./data/mgeorge.sqlite
# Separate 32-byte hex key for encrypted backups; store a protected copy separately.
MG_BACKUP_KEY=
# A protected absolute folder enables one verified backup per day while Node runs.
MG_BACKUP_DIRECTORY=
# Mandatory for HTTPS/public operation; at least 16 characters. Set via a protected secret store.
# Local http://localhost use remains password-free.
MG_ADMIN_PASSWORD=
# Enable Banking AIS integration (read-only; no payment initiation)
# No bank calls are possible without explicit environment and valid server key.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_ENVIRONMENT=SANDBOX
# Use exactly one key source. A file must be OUTSIDE this repository.
ENABLE_BANKING_PRIVATE_KEY_FILE=
# ENABLE_BANKING_PRIVATE_KEY=  (protected server env only; PKCS#8/PKCS#1 RSA PEM)
# PRODUCTION additionally requires HTTPS and confirmation AFTER replacing/revoking the leaked key.
ENABLE_BANKING_KEY_ROTATED=false
# Legacy ENABLEBANKING_APP_ID / ENABLEBANKING_PRIVATE_KEY_FILE / ENABLEBANKING_ENVIRONMENT aliases supported.
# Callback URL must be registered in Enable Banking (no query parameters)
# For production set APP_ORIGIN to your HTTPS domain, with no trailing slash.

# Gmail OAuth: readonly import, optional gmail.send after explicit new consent
# Google Cloud Web application; never commit real values
# Enable Gmail API and register APP_ORIGIN + /api/gmail/callback as the exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ACCOUNT=mg.vitvaror@gmail.com
