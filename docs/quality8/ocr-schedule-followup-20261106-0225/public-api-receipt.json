        "sha256": "bce2b361de0bec0053a0defa460216b5db1e57f6cb639e592b6ccd549c39cfa8",
        "gitBlobShaVerified": true,
        "text": "name: Sites cloud OCR\n\non:\n  schedule:\n    # Equivalent minutes 7,22,37,52. Refresh cron registration after an\n    # observed scheduling gap; a future actual scheduled run is still needed.\n    - cron: '7/15 * * * *'\n  workflow_dispatch:\n  workflow_run:\n    workflows: [Payment control checks]\n    types: [completed]\n    branches: [main]\n\n# Only reviewed default-branch code may receive the OCR credential. Resume the\n# durable queue after successful checks of the exact current main commit too;\n# the external periodic schedule may be delayed. Keep existing activation.\npermissions:\n  contents: read\nconcurrency:\n  group: sites-cloud-ocr\n  cancel-in-progress: false\n\njobs:\n  ocr:\n    if: >-\n      github.ref == 'refs/heads/main' && vars.MG_CLOUD_OCR_ENABLED == 'true' &&\n      (github.event_name != 'workflow_run' ||\n      (github.event.workflow_run.conclusion == 'success' &&\n      github.event.workflow_run.event == 'push' &&\n      github.event.workflow_run.head_branch == 'main' &&\n      github.event.workflow_run.head_repository.full_name == github.repository &&\n      github.event.workflow_run.head_sha == github.sha))\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          persist-credentials: false\n          ref: ${{ github.sha }}\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: '22'\n      - name: Verify reviewed main before dependency installation\n        run: node scripts/verify-cloud-ocr-trigger.mjs\n        env:\n          GITHUB_TOKEN: ${{ github.token }}\n      - name: Install locked OCR dependencies\n        run: npm ci --ignore-scripts --no-audit --no-fund\n      - name: Recheck current main before OCR credential use\n        run: node scripts/verify-cloud-ocr-trigger.mjs\n        env:\n          GITHUB_TOKEN: ${{ github.token }}\n      - name: Process at most six leased documents\n        run: node scripts/run-sites-cloud-ocr.mjs\n        env:\n          MG_SITES_ORIGIN: ${{ vars.MG_SITES_ORIGIN || secrets.MG_SITES_ORIGIN }}\n          MG_SITES_OCR_TOKEN: ${{ secrets.MG_SITES_OCR_TOKEN }}\n"
      }
    },
