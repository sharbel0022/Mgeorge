+  }catch(e){setError((e as Error).message);}finally{setBusy(false);}}
+  async function approve(e:React.FormEvent){e.preventDefault();if(!confirmed)return;setBusy(true);setError('');try{
+    const invoice={direction:values.direction==='customer'?'receivable':'payable',number:values.invoice_number,party:values.party,total:parseMoney(values.total_cents),issued:values.issued_at,due:values.due_at,ocr:values.reference,bankgiro:values.bankgiro,email:'',note:'',kind:values.kind,currency:values.currency};
