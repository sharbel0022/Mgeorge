+async function api(action:string,body?:unknown):Promise<any>{const r=await fetch('/api/gmail/'+action,{method:body===undefined?'GET':'POST',headers:body===undefined?{}:{'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body),cache:'no-store'});const data:any=await r.json();if(!r.ok)throw Error(data.error||'Gmail kunde inte uppdateras.');return data;}
+export default function GmailWorkspace(){
+  const [data,setData]=useState<any>(null),[error,setError]=useState(''),[message,setMessage]=useState(''),[busy,setBusy]=useState(false),[review,setReview]=useState<any>(null),[values,setValues]=useState<Record<string,string>>({}),[confirmed,setConfirmed]=useState(false);
+  async function load(){try{setData(await api('status'));}catch(e){setError((e as Error).message);}}
+  useEffect(()=>{void load();},[]);
+  useEffect(()=>()=>{if(review?.url)URL.revokeObjectURL(review.url);},[review]);
+  async function action(name:string){setBusy(true);setError('');try{const r=await api(name,{});if(r.url){location.assign(r.url);return;}setMessage(name==='sync'?`${r.imported} nya underlag · ${r.duplicates} dubbletter${r.more?' · Fler mejl finns att hämta':''}`:'Gmail har kopplats från.');await load();}catch(e){setError((e as Error).message);}finally{setBusy(false);}}
+  async function open(doc:any){setBusy(true);setError('');try{
+    const response=await fetch('/api/files?id='+encodeURIComponent(doc.document_id));if(!response.ok)throw Error('Originalet kunde inte hämtas.');
+    const file=new File([await response.blob()],doc.filename,{type:doc.mime}),meta=JSON.parse(doc.metadata),parsed=await readInvoiceFile(file,data.email),stored=JSON.parse(doc.extraction);
