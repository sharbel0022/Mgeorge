+  if(summary)return response({configured:isGmailConfigured()&&storageReady(),email:gmailAccount(),connection});
+  const candidates=await db().prepare("SELECT s.document_id,s.metadata,s.status,s.extraction,s.created_at,d.filename,d.mime FROM gmail_sources s JOIN documents d ON d.id=s.document_id AND d.owner=s.owner WHERE s.owner=? AND s.status<>'rejected' ORDER BY s.created_at DESC LIMIT 200").bind(user.userId).all();
