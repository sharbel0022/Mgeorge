+import {gmailStatus,gmailConnect,gmailCallback,gmailSync,gmailDisconnect,gmailReview,gmailFailure} from '@/lib/gmail-service';
+export const dynamic='force-dynamic';
+export async function GET(request:Request){try{const action=new URL(request.url).pathname.split('/').pop();if(action==='status')return await gmailStatus(new URL(request.url).searchParams.get('summary')==='1');if(action==='callback')return await gmailCallback(request);return new Response(null,{status:404});}catch(e){return gmailFailure(e);}}
+export async function POST(request:Request){try{const action=new URL(request.url).pathname.split('/').pop();if(action==='connect')return await gmailConnect(request);if(action==='sync')return await gmailSync(request);if(action==='disconnect')return await gmailDisconnect(request);if(action==='review')return await gmailReview(request);return new Response(null,{status:404});}catch(e){return gmailFailure(e);}}
