+'use client';
+import {useEffect,useState} from 'react';
+export default function GmailSummary(){
+  const [status,setStatus]=useState('Kontrollera anslutningen');
+  useEffect(()=>{const controller=new AbortController();fetch('/api/gmail/status?summary=1',{cache:'no-store',signal:controller.signal}).then(r=>r.ok?r.json():null).then((data:any)=>{if(data)setStatus(data.connection?.status==='connected'?'Ansluten':data.connection?'Behöver kontrolleras':'Ej ansluten');}).catch(()=>{});return()=>controller.abort();},[]);
+  return <a className="text-button" href="/gmail">Gmail: {status} →</a>;
+}
