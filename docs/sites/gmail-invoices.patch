+  }catch(e){setError((e as Error).message);}finally{setBusy(false);}}
+  const connected=data?.connection&&data.connection.status!=='renewal_required',docs=[...new Map((data?.candidates||[]).filter((d:any)=>d.status==='needs_review').map((d:any)=>[d.document_id,d])).values()] as any[];
+  return <main className="gmail-workspace"><a href="/" className="text-button">← MG Fakturakoll</a><div className="page-heading"><div><h1>Fakturor från Gmail</h1><p>Mottagna, arkiverade och skickade fakturabilagor. Granska originalet före registrering.</p></div></div>{error&&<p className="gmail-error" role="alert">{error}</p>}{message&&<p role="status">{message}</p>}
+    <section className="panel gmail-status"><h2>Gmail – {connected?'Ansluten':'Ej ansluten'}</h2><p>{data?.email||'mg.vitvaror@gmail.com'}</p><p>Senaste lyckade hämtning: {data?.connection?.last_synced?new Date(data.connection.last_synced).toLocaleString('sv-SE'):'Ingen hämtning ännu'}</p><div className="button-row"><button className="btn primary" disabled={busy} onClick={()=>action(connected?'sync':'connect')}>{busy?'Arbetar…':connected?'Hämta fakturaunderlag':'Koppla Gmail'}</button>{data?.connection&&<button className="btn" disabled={busy} onClick={()=>action('disconnect')}>Koppla från Gmail</button>}</div>{data&&!data.configured&&<details><summary>Administratör: aktivera Google-anslutningen</summary><p>Aktivera Gmail API i Google Cloud. Skapa en OAuth-webbklient med Gmail-läsbehörighet och lägg till mg.vitvaror@gmail.com som testanvändare medan appen testas. Ange GOOGLE_CLIENT_ID och GOOGLE_CLIENT_SECRET som skyddade Sites-variabler. Bevara den befintliga krypteringsnyckeln.</p><p>Registrera exakt returadress: <code>{typeof location!=='undefined'?location.origin:''}/api/gmail/callback</code>. Extern produktion kan kräva Googles verifiering av den begränsade Gmail-behörigheten. En testapp med extern publik kan få tidsbegränsade refresh tokens.</p></details>}<p className="body-description">Automatisk hämtning kräver en aktiverad molnschemaläggning och ett giltigt Google-medgivande. Dokumenttolkning körs lokalt i webbläsaren när du öppnar ett underlag för granskning.</p></section>
+    {!review?<section className="panel"><h2>{docs.length} underlag att granska</h2>{docs.length?<div className="table-scroll"><table><thead><tr><th>Dokument</th><th>Mejl</th><th>Hämtat</th><th></th></tr></thead><tbody>{docs.map(doc=>{const meta=JSON.parse(doc.metadata);return <tr key={doc.document_id}><td>{doc.filename}</td><td>{meta.subject}<small>{meta.from} → {meta.to}</small></td><td>{new Date(doc.created_at).toLocaleString('sv-SE')}</td><td><button className="btn" disabled={busy} onClick={()=>open(doc)}>Granska</button></td></tr>;})}</tbody></table></div>:<p>Hämta fakturabilagor eller koppla Gmail för att börja.</p>}</section>:<form className="panel" onSubmit={approve}><div className="gmail-review"><section><h2>Originaldokument</h2><a className="text-button" href={"/api/files?id="+encodeURIComponent(review.doc.document_id)} target="_blank" rel="noopener">Ladda ned hela originalet</a><img alt="Originalfaktura, första sidan" src={review.url}/><p>{review.meta.from} → {review.meta.to}</p><p>{review.meta.subject}</p></section><section><h2>{labels[review.extraction.level]}</h2><ul>{review.extraction.issues.map((i:string)=><li key={i}>{i}</li>)}</ul><p>Kontrollera markerade fält och redigera vid behov. Saknade uppgifter är tomma.</p><div className="form-grid"><label className="field">Typ<select value={values.direction} required onChange={e=>setValues(v=>({...v,direction:e.target.value}))}><option value="">Välj typ</option><option value="customer">Kundfaktura</option><option value="supplier">Leverantörsfaktura</option></select></label><label className="field">Dokumenttyp<select value={values.kind} onChange={e=>setValues(v=>({...v,kind:e.target.value}))}><option value="invoice">Faktura</option><option value="credit">Kreditfaktura – använd kreditflödet</option><option value="receipt">Kvitto</option><option value="other">Annat</option></select></label>{Object.entries(fieldLabels).map(([key,label])=><label className={`field ${(review.extraction.fields[key]?.confidence||0)<.9?'gmail-uncertain':''}`} key={key}>{label}<input type={key.endsWith('_at')?'date':key.endsWith('_cents')?'number':'text'} step={key.endsWith('_cents')?'0.01':undefined} value={values[key]||''} required={['invoice_number','party','issued_at','due_at','total_cents'].includes(key)} onChange={e=>setValues(v=>({...v,[key]:e.target.value}))}/></label>)}</div><label className="field">Valuta<select value={values.currency||''} required onChange={e=>setValues(v=>({...v,currency:e.target.value}))}><option value="">Kontrollera valutan</option><option value="SEK">SEK</option></select></label><label className="check-field"><input type="checkbox" required checked={confirmed} onChange={e=>setConfirmed(e.target.checked)}/>Jag har kontrollerat originalet och godkänner uppgifterna.</label><div className="button-row"><button className="btn primary" disabled={busy||values.kind!=='invoice'}>Godkänn faktura</button><button className="btn" type="button" onClick={()=>setReview(null)}>Stäng</button><button className="btn" disabled={busy} type="button" onClick={async()=>{try{await api('review',{document_id:review.doc.document_id,reject:true});setReview(null);await load();}catch(e){setError((e as Error).message);}}}>Avvisa</button></div></section></div></form>}
