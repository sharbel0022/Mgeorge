{
  "name": "mgeorge-fakturakoll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable M.George invoice and bank reconciliation system",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup/index.mjs",
    "start": "node scripts/start/index.mjs",
    "dev": "node scripts/start/index.mjs --dev",
    "test": "node --test test/*.test.js",
    "test:isolated": "node --import ./scripts/saas-test-isolation.mjs --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.mjs",
    "quality:node": "node scripts/quality/run.mjs node",
    "quality:sites": "node scripts/quality/run.mjs sites",
    "quality:bridge": "node scripts/quality/run.mjs bridge",
    "quality:performance": "node scripts/quality/run.mjs performance",
    "quality:browser": "node scripts/quality/run.mjs browser",
    "doctor": "node scripts/doctor/index.mjs",
    "stop": "node scripts/stop/index.mjs",
    "build": "node scripts/start/build.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@napi-rs/canvas": "0.1.80",
    "@tesseract.js-data/swe": "1.0.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "5.4.149",
    "tesseract.js": "6.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
